# Browser-safe Supabase project values from Project Settings → API.
# Never put the service-role key in a VITE_ variable.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Use `full` locally to continue developing prototype modules.
# Production GitHub Pages builds force this value to `inventory`.
VITE_RELEASE_SCOPE=full
